require 'base64'
require 'tmpdir'

default_platform(:ios)

platform :ios do
  desc 'Build and upload Indzon Vendor to TestFlight'
  lane :beta do
    bundle_id = ENV.fetch('IOS_BUNDLE_ID')
    team_id = ENV.fetch('IOS_TEAM_ID')
    key_id = ENV.fetch('APP_STORE_CONNECT_KEY_ID')
    issuer_id = ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')
    key_content = Base64.decode64(ENV.fetch('APP_STORE_CONNECT_KEY_BASE64'))

    setup_ci if ENV['CI']

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false
    )

    key_file = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    File.write(key_file, key_content)

    auth_args = [
      '-allowProvisioningUpdates',
      "-authenticationKeyPath #{key_file}",
      "-authenticationKeyID #{key_id}",
      "-authenticationKeyIssuerID #{issuer_id}"
    ].join(' ')

    update_code_signing_settings(
      use_automatic_signing: true,
      path: 'rnvendor.xcodeproj',
      team_id: team_id,
      bundle_identifier: bundle_id,
      targets: ['rnvendor']
    )

    begin
      build_number = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: bundle_id
      ) + 1
    rescue StandardError
      build_number = ENV.fetch('GITHUB_RUN_NUMBER', '1').to_i
    end

    increment_build_number(
      build_number: build_number,
      xcodeproj: 'rnvendor.xcodeproj'
    )

    build_app(
      workspace: 'rnvendor.xcworkspace',
      scheme: 'rnvendor',
      configuration: 'Release',
      clean: true,
      export_method: 'app-store',
      output_directory: '../build/ios',
      output_name: 'IndzonVendor.ipa',
      xcargs: auth_args,
      export_options: {
        signingStyle: 'automatic',
        teamID: team_id
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: '../build/ios/IndzonVendor.ipa'
    )
  end
end
